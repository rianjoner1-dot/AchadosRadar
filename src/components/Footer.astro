---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="brand-title">Achados<span class="brand-accent">Radar</span></div>
        <p class="brand-tagline">Vitrine independente para comparar ofertas. Confira os dados e a disponibilidade na loja de destino.</p>
      </div>

      <div class="footer-links">
        <div class="link-group">
          <span class="group-title">Navegação</span>
          <ul>
            <li><a href="/">Vitrine de Ofertas</a></li>
            <li><a href="/carrinho">Minha Lista de Interesse</a></li>
            <li><a href="/termos">Termos de Uso & Afiliados</a></li>
            <li><a href="/privacidade">Política de Privacidade</a></li>
          </ul>
        </div>
        <div class="link-group">
          <span class="group-title">Marketplaces</span>
          <ul>
            <li><a href="/?loja=mercadolivre">Mercado Livre</a></li>
            <li><a href="/?loja=magalu">Magazine Luiza</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-disclaimer">
      <p>
        <strong>Aviso de afiliados:</strong> O Achados Radar é uma vitrine independente e pode receber comissão por links identificados. Produtos de demonstração não possuem links de compra ativos. Não somos uma loja, não processamos pagamentos e não emitimos pedidos; a compra é concluída no marketplace de destino.
      </p>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} Achados Radar. Todos os direitos reservados.</p>
      <p class="tech-credit">Desenvolvido com foco em ultra-performance e acessibilidade.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: #eee;
    border-top: 1px solid var(--border-subtle);
    padding: 48px 0 24px;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 32px;
  }

  .footer-brand {
    max-width: 360px;
  }

  .brand-title {
    font-family: var(--font-heading);
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .brand-accent {
    color: var(--accent-cyan);
  }

  .brand-tagline {
    color: #707070;
    line-height: 1.5;
  }

  .footer-links {
    display: flex;
    gap: 48px;
  }

  .link-group ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .group-title {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--text-primary);
    font-size: 0.95rem;
    margin-bottom: 12px;
  }

  .footer-links a {
    color: var(--text-secondary);
    transition: color 0.2s ease;
    display: inline-block;
    padding: 2px 0;
  }

  .footer-links a:hover {
    color: #222;
  }

  .footer-disclaimer {
    background: #f8f8f8;
    border: 1px solid #dedede;
    border-radius: var(--radius-md);
    padding: 16px;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .footer-top {
      flex-direction: column;
      gap: 24px;
    }
    .footer-links {
      flex-direction: column;
      gap: 24px;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
