---
// src/components/Header.astro
---

<header class="site-header" role="banner">
  <div class="container header-inner">
    <a href="/" class="brand-logo" aria-label="Achados Radar - Página Inicial">
      <div class="radar-dot" aria-hidden="true"></div>
      <span class="brand-text">Achados<span class="brand-accent">Radar</span></span>
    </a>

    <div class="search-box-wrapper" role="search">
      <form action="/" method="GET" class="search-form">
        <label for="global-search-input" class="sr-only">Buscar produtos em promoção</label>
        <input
          id="global-search-input"
          type="search"
          name="q"
          placeholder="Buscar no radar (ex: air fryer, garrafa, suporte)..."
          autocomplete="off"
          class="search-input"
        />
        <button type="submit" class="search-btn" aria-label="Executar busca">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
      </form>
    </div>

    <nav class="nav-actions" aria-label="Navegação Principal">
      <a href="/carrinho" class="nav-btn" aria-label="Ver lista de interesses salva">
        <span class="nav-icon" aria-hidden="true">📌</span>
        <span class="nav-label">Minha Lista</span>
        <span class="cart-count-badge" id="headerCartCount" aria-label="0 itens salvos">0</span>
      </a>
      <a href="/conta" class="nav-btn account-nav-btn" aria-label="Entrar ou editar perfil">
        <span aria-hidden="true">◉</span><span class="account-label">Conta</span>
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 72px;
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: -.04em;
    color: var(--text-primary);
    min-height: 44px;
    min-width: 44px;
  }

  .radar-dot {
    width: 12px;
    height: 12px;
    background-color: var(--action);
    border-radius: 50%;
    box-shadow: none;
    animation: none;
  }

  .brand-accent {
    color: var(--text-primary);
  }

  .search-box-wrapper {
    flex: 1;
    max-width: 540px;
  }

  .search-form {
    display: flex;
    align-items: center;
    background: #fff;
    border: 1px solid #bdbdbd;
    border-radius: var(--radius-sm);
    padding: 2px 6px 2px 12px;
    transition: border-color 0.2s ease;
  }

  .search-form:focus-within {
    border-color: #777;
    box-shadow: 0 0 0 2px rgba(35, 89, 168, .16);
  }

  .search-input {
    width: 100%;
    background: transparent;
    border: none;
    color: var(--text-primary);
    font-size: 0.92rem;
    min-height: 40px;
  }

  .search-input:focus {
    outline: none;
  }

  .search-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    min-height: 38px;
    border-radius: 50%;
    color: #fff;
    background: #333;
    transition: background 0.2s ease;
  }

  .search-btn:hover {
    background: #111;
    color: #fff;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .nav-icon {
    font-size: 0;
    color: #333;
  }

  .nav-icon::before {
    content: "☆";
    font-size: 19px;
    line-height: 1;
  }

  .account-nav-btn > span:first-child {
    position: relative;
    display: inline-block;
    width: 17px;
    height: 17px;
    overflow: hidden;
    font-size: 0;
  }

  .account-nav-btn > span:first-child::before {
    position: absolute;
    top: 0;
    left: 5px;
    width: 6px;
    height: 6px;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    content: "";
  }

  .account-nav-btn > span:first-child::after {
    position: absolute;
    bottom: 0;
    left: 2px;
    width: 12px;
    height: 7px;
    border: 1.5px solid currentColor;
    border-radius: 8px 8px 3px 3px;
    content: "";
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 8px 14px;
    border-radius: var(--radius-md);
    background: #fff;
    border: 1px solid #ccc;
    font-size: 0.88rem;
    font-weight: 600;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .nav-btn:hover {
    background: #f7f7f7;
    border-color: #999;
  }

  .cart-count-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #333;
    color: #fff;
    font-size: 0.72rem;
    font-weight: 800;
    min-width: 20px;
    height: 20px;
    border-radius: 10px;
    padding: 0 6px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 640px) {
    .header-inner {
      height: auto;
      padding: 12px 16px;
      flex-wrap: wrap;
    }
    .search-box-wrapper {
      order: 3;
      flex: 0 0 100%;
      max-width: none;
      margin-top: 4px;
    }
    .nav-label {
      display: none;
    }
    .account-label { display: none; }
  }
</style>
