---
// src/pages/produto/[id].astro
import Layout from '../../layouts/Layout.astro';
import sampleProducts from '../../../tests/fixtures/sample_20_cards.json';
import { upgradeProductImageUrl } from '../../modules/catalog/image-identity.mjs';

export const prerender = true;

export function getStaticPaths() {
  return sampleProducts.map((p) => ({
    params: { id: p.id },
    props: { product: p }
  }));
}

const { product: sourceProduct } = Astro.props;
const product = { ...sourceProduct, image: upgradeProductImageUrl(sourceProduct.platform, sourceProduct.image) };
const isML = product.platform === 'mercadolivre';
const storeName = isML ? 'Mercado Livre' : 'Magalu';
const relatedProducts = sampleProducts.filter((item) => item.id !== product.id).map((item) => ({
  ...item,
  image: upgradeProductImageUrl(item.platform, item.image)
}));
const title = `${product.title} — Achados Radar`;
const description = `Exemplo de produto no Achados Radar: ${product.title}. A amostra local não possui link de compra verificado.`;
const productionHost = import.meta.env.PUBLIC_VERCEL_PROJECT_PRODUCTION_URL;
const canonicalOrigin = productionHost
  ? `https://${productionHost}`
  : import.meta.env.DEV ? Astro.url.origin : undefined;
const canonicalUrl = canonicalOrigin ? new URL(`/produto/${encodeURIComponent(product.id)}/`, canonicalOrigin).href : undefined;
---

<Layout title={title} description={description} canonicalUrl={canonicalUrl} ogImage={product.image} ogType="product">
  <div class="container product-detail-page">
    <nav class="breadcrumb-nav" aria-label="Navegação estrutural">
      <a href="/">Início</a>
      <span aria-hidden="true">&gt;</span>
      <a href={`/?loja=${product.platform}`}>{storeName}</a>
      <span aria-hidden="true">&gt;</span>
      <span aria-current="page" class="breadcrumb-current">{product.title}</span>
    </nav>

    <p class="demo-product-notice" role="status">Amostra de demonstração: preço e disponibilidade não foram confirmados agora, e esta página não possui link de compra ativo.</p>

    <div class="product-layout-grid">
      <!-- Coluna da Galeria -->
      <div class="gallery-column">
        <div class="main-image-frame">
          <img
            src={product.image}
            alt={product.title}
            width="600"
            height="600"
            class="detail-main-img"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>

      <!-- Coluna de Informações e Compra -->
      <div class="info-column">
        <div class="badges-row">
          <span class={`badge-platform ${isML ? 'badge-mercadolivre' : 'badge-magalu'}`}>
            {storeName}
          </span>
          <span class="badge-seller">
            Vendido por: <strong>{product.sellerName || 'Loja Parceira'}</strong>
          </span>
        </div>

        <h1 class="product-heading">{product.title}</h1>

        <div class="price-box">
          {product.oldPriceFormatted && (
            <span class="old-price">{product.oldPriceFormatted}</span>
          )}
          <div class="price-main-row">
            <span class="price-value">{product.priceFormatted}</span>
            {product.discountPercent && (
              <span class="badge-discount">{product.discountPercent}</span>
            )}
          </div>
          {product.installments && (
            <span class="installments-note">{product.installments}</span>
          )}
        </div>

        {product.shipping && (
          <div class="detail-shipping-card">
            <span aria-hidden="true">🚚</span>
            <span>{product.shipping}</span>
          </div>
        )}

        {product.coupon && (
          <div class="detail-coupon-card">
            <span aria-hidden="true">🏷️</span>
            <span>Cupom disponível: <strong>{product.coupon}</strong></span>
          </div>
        )}

        <div class="stock-indicator">
          <span class="status-dot-muted" aria-hidden="true"></span>
          <span>Disponibilidade não verificada nesta demonstração</span>
        </div>

        <!-- Botões de Ação -->
        <div class="action-buttons-stack">
          <button type="button" class="btn-primary buy-now-btn" disabled aria-disabled="true">Compra indisponível nesta demonstração</button>

          <button
            type="button"
            class="btn-secondary add-to-list-btn"
            data-action="save-item"
            data-item={JSON.stringify(product)}
            aria-label="Salvar produto na minha lista de interesses"
          >
            <span aria-hidden="true">📌</span>
            <span>Salvar na Minha Lista</span>
          </button>
          <div class="share-actions" aria-label="Compartilhar produto">
            <button type="button" id="shareDemoWhatsApp" class="btn-secondary share-demo-action" aria-label="Compartilhar pelo WhatsApp">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20.52 3.48A11.82 11.82 0 0 0 12.1 0C5.54 0 .2 5.33.2 11.9c0 2.1.55 4.15 1.6 5.96L.1 24l6.3-1.65a11.9 11.9 0 0 0 5.7 1.45h.01c6.56 0 11.9-5.34 11.9-11.9 0-3.18-1.24-6.17-3.49-8.42ZM12.1 21.78h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.74.98 1-3.65-.24-.38a9.85 9.85 0 0 1-1.52-5.24c0-5.47 4.45-9.92 9.92-9.92 2.65 0 5.14 1.03 7.01 2.91a9.86 9.86 0 0 1 2.9 7.02c0 5.47-4.45 9.92-9.92 9.92Zm5.44-7.43c-.3-.15-1.77-.87-2.04-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.47-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.22 3.07c.15.2 2.1 3.21 5.08 4.5.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.58-.09 1.77-.72 2.02-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/></svg>
              <span>WhatsApp</span>
            </button>
            <button type="button" id="shareDemoCopyLink" class="btn-secondary share-demo-action" aria-label="Copiar link do produto">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></svg>
              <span>Copiar link</span>
            </button>
          </div>
          <p id="shareDemoStatus" class="share-demo-status" role="status" aria-live="polite"></p>
        </div>

        <div class="disclaimer-mini-card">
          <p>
            <strong>Dados de exemplo.</strong> O preço exibido serve apenas para demonstrar o layout e pode estar desatualizado. Nenhum redirecionamento ou link afiliado está ativo nesta página de amostra.
          </p>
        </div>
      </div>
    </div>

    <section class="demo-related-section" aria-labelledby="demo-related-title">
      <h2 id="demo-related-title">Mais ofertas para comparar</h2>
      <p class="demo-related-note">Outras amostras para comparar entre as lojas. Preços e disponibilidade não foram confirmados.</p>
      <div id="demoRelatedGrid" class="demo-related-grid" aria-live="polite">
        {relatedProducts.map((item, index) => (
          <article class="demo-related-card" data-demo-related-card hidden={index >= 8}>
            <a href={`/produto/${encodeURIComponent(item.id)}`} aria-label={`Ver ${item.title}`}>
              <img src={item.image} alt="" width="220" height="170" loading="lazy" decoding="async" />
              <small>{item.platform === 'magalu' ? 'Magalu' : 'Mercado Livre'}</small>
              <span>{item.title}</span>
            </a>
            <strong>{item.priceFormatted}</strong>
          </article>
        ))}
      </div>
      <button id="demoRelatedMore" class="btn-secondary demo-related-more" type="button" hidden>Carregar mais ofertas</button>
      <p id="demoRelatedStatus" class="demo-related-status" role="status" aria-live="polite"></p>
    </section>
  </div>
</Layout>

<script>
  import { copyProductLink, getWhatsAppShareUrl } from '../../modules/catalog/share.js';
  import { bindImageFailureReporting } from '../../modules/catalog/image-fallback.js';
  import { isKnownUnavailableMercadoLivreImage } from '../../modules/catalog/image-health.js';

  const grid = document.querySelector<HTMLElement>('#demoRelatedGrid');
  const more = document.querySelector<HTMLButtonElement>('#demoRelatedMore');
  const status = document.querySelector<HTMLElement>('#demoRelatedStatus');
  if (grid) {
    bindImageFailureReporting(grid, {
      selector: '.demo-related-card img:not([data-fallback-bound])',
      productSelector: '[data-demo-related-card]',
      placeholderClass: 'demo-related-image-placeholder',
      reportFailure: () => {},
    });
    for (const image of grid.querySelectorAll<HTMLImageElement>('.demo-related-card img')) {
      const imageUrl = image.currentSrc || image.src;
      if (!imageUrl.startsWith('https://http2.mlstatic.com/')) continue;
      void isKnownUnavailableMercadoLivreImage(imageUrl).then((unavailable) => {
        if (unavailable && image.isConnected && image.dataset.failureHandled !== 'true') {
          image.dispatchEvent(new Event('error'));
        }
      });
    }
  }
  if (grid && more) {
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-demo-related-card]')];
    let visibleCount = Math.min(8, cards.length);
    more.hidden = visibleCount >= cards.length;
    const revealNext = () => {
      const nextCount = Math.min(visibleCount + 8, cards.length);
      for (let index = visibleCount; index < nextCount; index++) cards[index].hidden = false;
      visibleCount = nextCount;
      more.hidden = visibleCount >= cards.length;
      if (more.hidden && status) status.textContent = 'Você chegou ao fim dos exemplos disponíveis.';
    };
    more.addEventListener('click', revealNext);
    if ('IntersectionObserver' in window && !more.hidden) {
      const observer = new IntersectionObserver((entries) => {
        if (entries.some((entry) => entry.isIntersecting)) revealNext();
      }, { rootMargin: '500px' });
      observer.observe(more);
    }
  }

  const shareStatus = document.querySelector<HTMLElement>('#shareDemoStatus');
  document.querySelector<HTMLButtonElement>('#shareDemoWhatsApp')?.addEventListener('click', () => {
    window.open(getWhatsAppShareUrl({ title: document.title, url: location.href }), '_blank', 'noopener,noreferrer');
    if (shareStatus) shareStatus.textContent = 'Link preparado para compartilhar pelo WhatsApp.';
  });
  document.querySelector<HTMLButtonElement>('#shareDemoCopyLink')?.addEventListener('click', async () => {
    const result = await copyProductLink({ url: location.href, navigatorApi: navigator, documentApi: document });
    if (shareStatus) shareStatus.textContent = result === 'copied' ? 'Link do produto copiado.' : `Copie o link do produto: ${location.href}`;
  });
</script>

<style>
  .product-detail-page {
    padding: 32px 16px 64px;
    max-width: 1120px;
  }
  .share-actions { display:flex; width:100%; gap:10px; }
  .share-demo-action { min-width:0; min-height:44px; flex:1; gap:8px; }
  .share-demo-status { min-height:1.2em; color:#555; font-size:.85rem; overflow-wrap:anywhere; }

  .breadcrumb-nav {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    min-width: 0;
    gap: 8px;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 24px;
    overflow: hidden;
    white-space: nowrap;
  }

  .breadcrumb-nav a {
    color: var(--text-secondary);
  }

  .breadcrumb-nav a:hover {
    color: var(--text-primary);
  }

  .breadcrumb-current {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text-primary);
    font-weight: 500;
  }

  .product-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  @media (min-width: 768px) {
    .product-layout-grid {
      grid-template-columns: 1fr 1fr;
      gap: 48px;
    }
  }

  .main-image-frame {
    background: #fff;
    border: 1px solid #dedede;
    border-radius: var(--radius-lg);
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    overflow: hidden;
  }

  .demo-product-notice {
    margin: 0 0 20px;
    padding: 12px 14px;
    border: 1px solid #dedede;
    border-left: 4px solid #9a7800;
    border-radius: var(--radius-sm);
    background: #fff8e5;
    color: #453800;
    font-size: .9rem;
    line-height: 1.5;
  }

  .status-dot-muted { width: 9px; height: 9px; border-radius: 50%; background: #888; flex: 0 0 auto; }

  .detail-main-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .info-column {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .badges-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .product-heading {
    font-size: clamp(1.4rem, 2.5vw, 1.85rem);
    line-height: 1.25;
  }

  .price-box {
    display: flex;
    flex-direction: column;
    padding: 16px;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .old-price {
    font-size: 0.9rem;
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .price-main-row {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .price-value {
    font-size: 2rem;
    font-weight: 800;
    font-family: var(--font-heading);
    color: #222;
  }

  .badge-discount {
    background: #eee;
    color: #333;
    font-weight: 800;
    font-size: 0.8rem;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .installments-note {
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .detail-shipping-card {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--accent-emerald);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .detail-coupon-card {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(245, 158, 11, 0.12);
    border: 1px dashed rgba(245, 158, 11, 0.4);
    color: var(--accent-amber);
    padding: 8px 12px;
    border-radius: var(--radius-md);
    font-size: 0.88rem;
  }

  .stock-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .status-dot-green {
    width: 8px;
    height: 8px;
    background-color: var(--accent-emerald);
    border-radius: 50%;
  }

  .action-buttons-stack {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }

  .buy-now-btn {
    min-height: 52px;
    font-size: 1.05rem;
  }

  .add-to-list-btn {
    min-height: 48px;
  }

  .disclaimer-mini-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 12px 16px;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .demo-related-section { margin-top: 36px; padding-top: 24px; border-top: 1px solid var(--border-subtle); }
  .demo-related-section h2 { margin: 0; color: var(--text-primary); font-size: 1.25rem; }
  .demo-related-note { margin: 6px 0 16px; color: var(--text-secondary); font-size: .86rem; }
  .demo-related-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
  .demo-related-card { display: flex; flex-direction: column; overflow: hidden; padding-bottom: 10px; border: 1px solid var(--border-subtle); border-radius: var(--radius-md); background: var(--bg-surface); }
  .demo-related-card[hidden] { display: none; }
  .demo-related-card a { display: flex; flex: 1; flex-direction: column; color: var(--text-primary); text-decoration: none; }
  .demo-related-card img { width: 100%; height: 150px; object-fit: contain; padding: 10px; background: #fff; }
  .demo-related-card :global(.demo-related-image-placeholder) { display: grid; width: 100%; height: 150px; place-items: center; padding: 10px; background: #f6f6f6; color: var(--text-muted); font-size: .82rem; }
  .demo-related-card a span { padding: 8px 10px; font-size: .84rem; line-height: 1.35; }
  .demo-related-card strong { padding: 0 10px; color: var(--text-primary); }
  .demo-related-more { display: block; min-width: 220px; margin: 18px auto 0; }
  .demo-related-status { min-height: 1.3em; margin-top: 10px; color: var(--text-muted); text-align: center; font-size: .8rem; }
  @media (max-width: 760px) { .demo-related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
