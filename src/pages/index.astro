---
import Layout from '../layouts/Layout.astro';
import demoProducts from '../../tests/fixtures/sample_20_cards.json';
import { catalogReady } from '../modules/catalog/client';

export const prerender = true;

const title = 'Achados Radar | Ofertas para comparar';
const description = 'Compare ofertas observadas no Mercado Livre e Magalu. A compra é concluída na loja parceira.';
const demo = demoProducts.map((product) => ({
  ...product,
  demo: true,
  image: product.image,
  detailUrl: `/produto/${encodeURIComponent(product.id)}`
}));
---

<Layout title={title} description={description}>
  <section class="home-intro">
    <div class="container intro-inner">
      <p class="eyebrow">ACHADOS RADAR</p>
      <h1>Encontre sua próxima boa compra</h1>
      <p>Ofertas observadas em lojas parceiras. Compare as informações e finalize diretamente no marketplace.</p>
      <ul class="intro-points" aria-label="Informações disponíveis nas ofertas">
        <li><span aria-hidden="true">01</span> Preço e oferta observados</li>
        <li><span aria-hidden="true">02</span> Frete e parcelas quando disponíveis</li>
        <li><span aria-hidden="true">03</span> Compra finalizada na loja</li>
      </ul>
      {!catalogReady && <p class="demo-notice" role="status">Modo de demonstração: os produtos de exemplo não têm links de compra ativos.</p>}
    </div>
  </section>

  <section class="container spotlight-section" id="spotlightSection" aria-labelledby="spotlightTitle" hidden>
    <div class="spotlight-heading">
      <div><p class="spotlight-eyebrow">SELEÇÃO DO RADAR</p><h2 id="spotlightTitle">Achados que merecem um olhar</h2><p>Confira preço, entrega e condições observadas antes de seguir para a loja.</p></div>
      <span id="spotlightCount" class="spotlight-count"></span>
    </div>
    <div id="spotlightGrid" class="spotlight-grid"></div>
  </section>

  <section class="container catalog-section" aria-labelledby="catalog-title">
    <h2 id="catalog-title">Buscar ofertas</h2>
    <form id="catalogFilters" class="catalog-filters">
      <label class="filter-search">Busca
        <input id="catalogSearch" type="search" name="q" placeholder="Ex.: brinco, air fryer, fone..." autocomplete="off" />
      </label>
      <label>Loja
        <select id="platformFilter" name="loja">
          <option value="all">Todas as lojas</option><option value="mercadolivre">Mercado Livre</option><option value="magalu">Magalu</option>
        </select>
      </label>
      <label>Preço mínimo <input id="minPrice" type="number" name="min" min="0" step="0.01" inputmode="decimal" placeholder="R$ 0" /></label>
      <label>Preço máximo <input id="maxPrice" type="number" name="max" min="0" step="0.01" inputmode="decimal" placeholder="Sem limite" /></label>
      <label>Ordenar
        <select id="sortFilter" name="ordem"><option value="recent">Mais recentes</option><option value="price_asc">Menor preço</option><option value="price_desc">Maior preço</option></select>
      </label>
      <button class="btn-primary" type="submit">Aplicar</button>
    </form>

    <div class="results-heading"><h2 id="resultsTitle">Ofertas</h2><span id="catalogStatus" aria-live="polite">Carregando...</span></div>
    <div id="catalogGrid" class="catalog-grid" data-loading="true" aria-live="polite">
      {(catalogReady || demo.length === 0) && Array.from({ length: 20 }, () => (
        <article class="catalog-card catalog-skeleton" data-catalog-skeleton aria-hidden="true">
          <div class="catalog-image skeleton-image"></div>
          <div class="catalog-card-body"><span class="skeleton-line skeleton-store"></span><span class="skeleton-line skeleton-title"></span><span class="skeleton-line skeleton-price"></span><span class="skeleton-line skeleton-button"></span></div>
        </article>
      ))}
      {!catalogReady && demo.map((product) => (
        <article class="catalog-card" data-demo-card data-platform={product.platform} data-search-title={product.title} data-search-seller={product.sellerName || ''} data-price={product.price}>
          <a class="catalog-image" href={product.detailUrl} aria-label={`Ver ${product.title}`}><img src={product.image} alt={product.title} width="320" height="260" loading="lazy" decoding="async" /></a>
          <div class="catalog-card-body">
            <span class="store-label">{product.storeName || (product.platform === 'magalu' ? 'Magalu' : 'Mercado Livre')}</span>
            <h3><a href={product.detailUrl}>{product.title}</a></h3>
            <p class="seller-label">Vendido por {product.sellerName || 'loja parceira'}</p>
            <p class="catalog-price">{product.priceFormatted}</p>
            <a class="btn-secondary card-detail-link" href={product.detailUrl}>Ver detalhes</a>
          </div>
        </article>
      ))}
    </div>
    <p id="catalogEmpty" class="catalog-empty" hidden>Nenhuma oferta corresponde a esses filtros. Altere a busca e tente novamente.</p>
    <button type="button" id="loadMore" class="btn-secondary load-more" hidden>Carregar mais ofertas</button>
    <div id="catalogSentinel" aria-hidden="true"></div>
  </section>
</Layout>

<script>
  import { catalogReady, escapeHtml, formatPrice, reportCatalogImageFailure, searchCatalog, type CatalogProduct } from '../modules/catalog/client';
  import { selectSpotlightOffers } from '../modules/catalog/spotlights.mjs';
  import { isKnownUnavailableMercadoLivreImage, preloadProductImage } from '../modules/catalog/image-health.js';
  import { matchesDemoProduct } from '../modules/catalog/search-utils.js';
  import { bindImageFailureReporting } from '../modules/catalog/image-fallback.js';

  const form = document.querySelector<HTMLFormElement>('#catalogFilters')!;
  const grid = document.querySelector<HTMLElement>('#catalogGrid')!;
  const status = document.querySelector<HTMLElement>('#catalogStatus')!;
  const empty = document.querySelector<HTMLElement>('#catalogEmpty')!;
  const loadMore = document.querySelector<HTMLButtonElement>('#loadMore')!;
  const sentinel = document.querySelector<HTMLElement>('#catalogSentinel')!;
  const spotlightSection = document.querySelector<HTMLElement>('#spotlightSection')!;
  const spotlightGrid = document.querySelector<HTMLElement>('#spotlightGrid')!;
  const spotlightCount = document.querySelector<HTMLElement>('#spotlightCount')!;
  let spotlightProducts: CatalogProduct[] = [];
  const failedSpotlightImages = new Set<string>();
  const imageDestinationChecks = new Map<string, Promise<boolean>>();
  let spotlightRenderVersion = 0;
  const queryInput = document.querySelector<HTMLInputElement>('#catalogSearch')!;
  const globalSearch = document.querySelector<HTMLInputElement>('#global-search-input');
  let cursor: { created_at: string; id: string; price?: number | null; score?: number | null } | null = null;
  let controller: AbortController | null = null;
  let loading = false;
  let autoLoadEnabled = true;
  let requestVersion = 0;
  let appendedCount = 0;
  let firstPageSettled = false;

  function reserveFirstPageHeight() {
    if (firstPageSettled) return;
    const columns = window.matchMedia('(max-width: 640px)').matches ? 2 : window.matchMedia('(max-width: 980px)').matches ? 3 : 4;
    const rows = Math.ceil(20 / columns);
    const skeleton = grid.querySelector<HTMLElement>('[data-catalog-skeleton]');
    const cardHeight = skeleton?.getBoundingClientRect().height || 410;
    const styles = window.getComputedStyle(grid);
    const rowGap = Number.parseFloat(styles.rowGap) || 14;
    grid.style.minHeight = `${rows * cardHeight + Math.max(0, rows - 1) * rowGap}px`;
  }
  reserveFirstPageHeight();
  window.addEventListener('resize', reserveFirstPageHeight, { passive: true });

  const safeImage = (product: CatalogProduct) => product.images?.[0]?.url ?? '';
  function renderSpotlightCard(entry: ReturnType<typeof selectSpotlightOffers>[number], featured = false) {
    const { product, discountPercent } = entry;
    const id = encodeURIComponent(product.id);
    const image = safeImage(product);
    const store = product.platform === 'magalu' ? 'Magalu' : 'Mercado Livre';
    const offer = product.offer;
    const discount = discountPercent
      ? `<span class="spotlight-discount">${discountPercent}% abaixo do preço anterior informado</span><span class="spotlight-old-price">De ${formatPrice(offer?.old_price)}</span>`
      : '';
    const detail = offer?.coupon_code
      ? `Condição observada: cupom ${escapeHtml(offer.coupon_code)}. Confira as regras na loja.`
      : offer?.shipping_text
        ? `Confira entrega e condições observadas na página do produto.`
        : 'Veja as informações da oferta e confira as condições na loja.';
    const imageMarkup = image
      ? `<img class="spotlight-image" src="${escapeHtml(image)}" data-original-image-url="${escapeHtml(image)}" alt="${escapeHtml(product.title)}" width="640" height="480" loading="lazy" decoding="async">`
      : '<span class="spotlight-image-placeholder" role="img" aria-label="Foto indisponível">Foto indisponível</span>';
    return `<article class="spotlight-card${featured ? ' spotlight-card-featured' : ''}" data-product-id="${id}">
      <a class="spotlight-media" href="/produto?id=${id}" aria-label="Ver ${escapeHtml(product.title)}">${imageMarkup}</a>
      <div class="spotlight-copy"><span class="spotlight-store">${store} · oferta observada</span>
      ${discount}
      <h3><a href="/produto?id=${id}">${escapeHtml(product.title)}</a></h3>
      <p class="spotlight-detail">${detail}</p>
      <p class="spotlight-price">${formatPrice(offer?.price)}</p>
      ${offer?.installments_text ? `<p class="spotlight-fact">${escapeHtml(offer.installments_text)}</p>` : ''}
      <a class="spotlight-action" href="/produto?id=${id}">Conferir este achado <span aria-hidden="true">→</span></a></div></article>`;
  }

  function renderSpotlights(products: CatalogProduct[], resetFailedImages = false) {
    if (resetFailedImages || products !== spotlightProducts) {
      spotlightProducts = products;
      failedSpotlightImages.clear();
    }
    const candidates = selectSpotlightOffers(products, products.length, failedSpotlightImages);
    const selected = candidates.slice(0, 3);
    spotlightGrid.replaceChildren();
    if (!selected.length) { spotlightSection.hidden = true; return; }
    const [featured, ...secondary] = selected;
    spotlightGrid.dataset.count = String(selected.length);
    spotlightGrid.insertAdjacentHTML('beforeend', renderSpotlightCard(featured, true));
    if (secondary.length) {
      const side = document.createElement('div');
      side.className = 'spotlight-side';
      side.innerHTML = secondary.map((entry) => renderSpotlightCard(entry)).join('');
      spotlightGrid.append(side);
    }
    spotlightCount.textContent = `${selected.length} ofertas disponíveis na última consulta`;
    spotlightSection.hidden = false;
    bindImageFailureReporting(spotlightGrid, {
      selector: '.spotlight-image:not([data-fallback-bound])',
      placeholderClass: 'spotlight-image-placeholder',
      reportFailure: (productId, imageUrl) => { void reportCatalogImageFailure(productId, imageUrl); }
    });
  }

  function checkSpotlightImageDestination(imageUrl: string) {
    let check = imageDestinationChecks.get(imageUrl);
    if (!check) {
      check = (async () => {
        const imageLoaded = await preloadProductImage(imageUrl);
        if (imageLoaded === false) return true;
        if (imageLoaded === true) return isKnownUnavailableMercadoLivreImage(imageUrl);
        return false;
      })();
      imageDestinationChecks.set(imageUrl, check);
      if (imageDestinationChecks.size > 100) imageDestinationChecks.delete(imageDestinationChecks.keys().next().value!);
    }
    return check;
  }

  async function prepareSpotlights(products: CatalogProduct[], resetFailedImages = false) {
    if (resetFailedImages || products !== spotlightProducts) {
      spotlightProducts = products;
      failedSpotlightImages.clear();
    }
    const version = ++spotlightRenderVersion;
    const inspectedProducts = new Set<string>();
    while (version === spotlightRenderVersion) {
      const selected = selectSpotlightOffers(products, 3, failedSpotlightImages);
      const unchecked = selected.filter(({ product }) => {
        const image = safeImage(product);
        return image && !inspectedProducts.has(product.id);
      });
      if (!unchecked.length) break;
      for (const { product } of unchecked) inspectedProducts.add(product.id);
      const missing = await Promise.all(unchecked.map(async ({ product }) => {
        const image = safeImage(product);
        const unavailable = await checkSpotlightImageDestination(image);
        return unavailable ? { product, image } : null;
      }));
      if (version !== spotlightRenderVersion) return;
      for (const item of missing) {
        if (!item) continue;
        failedSpotlightImages.add(item.product.id);
        void reportCatalogImageFailure(item.product.id, item.image);
      }
      if (!missing.some(Boolean)) break;
    }
    if (version === spotlightRenderVersion) renderSpotlights(products);
  }

  function skipSpotlightImage(productId: string) {
    if (!productId || failedSpotlightImages.has(productId)) return;
    failedSpotlightImages.add(productId);
    queueMicrotask(() => { void prepareSpotlights(spotlightProducts); });
  }

  spotlightGrid.addEventListener('error', (event) => {
    const image = event.target;
    if (!(image instanceof HTMLImageElement) || !image.classList.contains('spotlight-image')) return;
    const card = image.closest<HTMLElement>('[data-product-id]');
    const productId = card?.dataset.productId;
    if (!productId) return;
    skipSpotlightImage(decodeURIComponent(productId));
  }, true);
  new MutationObserver((records) => {
    for (const record of records) for (const node of record.addedNodes) {
      if (!(node instanceof HTMLElement)) continue;
      const placeholders = node.matches('.spotlight-image-placeholder') ? [node] : [...node.querySelectorAll<HTMLElement>('.spotlight-image-placeholder')];
      for (const placeholder of placeholders) {
        const productId = placeholder.closest<HTMLElement>('[data-product-id]')?.dataset.productId;
        if (productId) skipSpotlightImage(decodeURIComponent(productId));
      }
    }
  }).observe(spotlightGrid, { childList: true, subtree: true });

  function renderCard(product: CatalogProduct) {
    const id = encodeURIComponent(product.id);
    const store = product.platform === 'magalu' ? 'Magalu' : 'Mercado Livre';
    const offer = product.offer;
    const price = formatPrice(offer?.price);
    const observedAt = offer?.observed_at ? new Date(offer.observed_at).toLocaleString('pt-BR') : '';
    const image = safeImage(product);
    return `<article class="catalog-card" data-product-id="${id}">
      <a class="catalog-image" href="/produto?id=${id}" aria-label="Ver ${escapeHtml(product.title)}">${image ? `<img src="${escapeHtml(image)}" data-original-image-url="${escapeHtml(image)}" alt="${escapeHtml(product.title)}" width="320" height="260" loading="lazy" decoding="async">` : '<span class="image-placeholder">Imagem indisponível</span>'}</a>
      <div class="catalog-card-body"><span class="store-label">${store}</span><h3><a href="/produto?id=${id}">${escapeHtml(product.title)}</a></h3>
      <p class="seller-label">Vendido por ${escapeHtml(offer?.seller_name || store)}</p><p class="catalog-price">${price}</p>
      ${offer?.installments_text ? `<p class="catalog-meta">${escapeHtml(offer.installments_text)}</p>` : ''}
      ${offer?.shipping_text ? `<p class="catalog-meta">${escapeHtml(offer.shipping_text)}</p>` : ''}
      ${offer?.coupon_code ? `<p class="coupon-label">Cupom: ${escapeHtml(offer.coupon_code)}</p>` : ''}
      <p class="catalog-meta">${offer?.stock_status === 'out_of_stock' ? 'Sem estoque na última consulta' : offer?.stock_status === 'in_stock' ? 'Disponível na última consulta' : 'Estoque não confirmado'}${observedAt ? ` · consultado ${escapeHtml(observedAt)}` : ''}</p>
      <a class="btn-secondary card-detail-link" href="/produto?id=${id}">Ver detalhes</a></div></article>`;
  }

  function currentFilters() {
    const params = new FormData(form);
    return { q: String(params.get('q') || ''), platform: String(params.get('loja') || 'all'), min: Number(params.get('min')) || undefined, max: Number(params.get('max')) || undefined, sort: String(params.get('ordem') || 'recent') };
  }

  function filterDemo() {
    grid.removeAttribute('data-loading');
    const filters = currentFilters();
    const query = filters.q;
    let visible = 0;
    const cards = [...grid.querySelectorAll<HTMLElement>('[data-demo-card]')];
    for (const card of cards) {
      const matches = matchesDemoProduct(query, card.dataset.searchTitle || '', card.dataset.searchSeller || '')
        && (filters.platform === 'all' || card.dataset.platform === filters.platform)
        && (filters.min === undefined || Number(card.dataset.price) >= filters.min)
        && (filters.max === undefined || Number(card.dataset.price) <= filters.max);
      card.hidden = !matches;
      if (matches) visible++;
    }
    if (filters.sort !== 'recent') {
      cards.sort((a, b) => (Number(a.dataset.price) - Number(b.dataset.price)) * (filters.sort === 'price_desc' ? -1 : 1));
      cards.forEach((card) => grid.append(card));
    }
    status.textContent = `${visible} exemplo${visible === 1 ? '' : 's'} locais · sem links de compra`;
    empty.hidden = visible > 0;
  }

  function syncUrl() {
    const params = new URLSearchParams();
    for (const [key, value] of new FormData(form).entries()) if (String(value).trim() && !(key === 'loja' && value === 'all') && !(key === 'ordem' && value === 'recent')) params.set(key, String(value));
    history.replaceState(null, '', `${location.pathname}${params.size ? `?${params}` : ''}`);
  }

  async function load(reset: boolean) {
    if (reset) {
      requestVersion++;
      loading = false;
      autoLoadEnabled = true;
      loadMore.textContent = 'Carregar mais ofertas';
      controller?.abort();
      controller = new AbortController();
      cursor = null;
      appendedCount = 0;
    }
    if (!catalogReady || loading) return;
    loading = true;
    loadMore.disabled = true;
    status.textContent = 'Buscando ofertas...';
    const version = requestVersion;
    try {
      const products = await searchCatalog({ ...currentFilters(), cursor, limit: 20, signal: controller?.signal });
      if (version !== requestVersion) return;
      if (reset) { grid.replaceChildren(); void prepareSpotlights(products, true); }
      grid.insertAdjacentHTML('beforeend', products.map(renderCard).join(''));
      grid.removeAttribute('data-loading');
      if (reset) {
        firstPageSettled = true;
        grid.style.removeProperty('min-height');
        window.removeEventListener('resize', reserveFirstPageHeight);
      }
      bindImageFailureReporting(grid, {
        selector: '.catalog-image img:not([data-fallback-bound])',
        placeholderClass: 'image-placeholder',
        reportFailure: (productId, imageUrl) => { void reportCatalogImageFailure(productId, imageUrl); }
      });
      appendedCount += products.length;
      if (products.length) cursor = { created_at: products[products.length - 1].created_at, id: products[products.length - 1].id, price: products[products.length - 1].offer?.price ?? null, score: products[products.length - 1].search_score ?? null };
      status.textContent = products.length === 0 && !reset && appendedCount > 0
        ? `Fim das ofertas disponíveis. ${appendedCount} produtos carregados.`
        : `${appendedCount} oferta${appendedCount === 1 ? '' : 's'}${products.length === 20 ? ' · role ou carregue mais' : ''}`;
      empty.hidden = appendedCount > 0;
      loadMore.hidden = products.length < 20;
      autoLoadEnabled = true;
      loadMore.textContent = 'Carregar mais ofertas';
      if (appendedCount > 80) {
        const removable = grid.querySelectorAll('.catalog-card');
        for (let i = 0; i < removable.length - 80; i++) removable[i].remove();
      }
    } catch (error) {
      if ((error as Error).name !== 'AbortError') {
        autoLoadEnabled = false;
        if (reset) grid.replaceChildren();
        grid.removeAttribute('data-loading');
        if (reset) {
          firstPageSettled = true;
          grid.style.removeProperty('min-height');
          window.removeEventListener('resize', reserveFirstPageHeight);
        }
        status.textContent = 'Não foi possível carregar. Verifique a conexão e tente novamente.';
        if (reset) spotlightSection.hidden = true;
        loadMore.hidden = false;
        loadMore.textContent = 'Tentar novamente';
      }
    } finally {
      if (version === requestVersion) { loading = false; loadMore.disabled = false; }
    }
  }

  const query = new URLSearchParams(location.search);
  queryInput.value = query.get('q') ?? '';
  if (globalSearch) globalSearch.value = queryInput.value;
  (document.querySelector('#platformFilter') as HTMLSelectElement).value = query.get('loja') ?? 'all';
  (document.querySelector('#minPrice') as HTMLInputElement).value = query.get('min') ?? '';
  (document.querySelector('#maxPrice') as HTMLInputElement).value = query.get('max') ?? '';
  (document.querySelector('#sortFilter') as HTMLSelectElement).value = query.get('ordem') ?? 'recent';

  if (catalogReady) {
    status.textContent = 'Carregando ofertas atualizadas do catálogo...';
    void load(true);
  } else {
    filterDemo();
    bindImageFailureReporting(grid, {
      selector: '.catalog-image img:not([data-fallback-bound])',
      placeholderClass: 'image-placeholder',
      reportFailure: (productId, imageUrl) => {
        if (catalogReady) void reportCatalogImageFailure(productId, imageUrl);
      }
    });
  }

  let debounce: number;
  queryInput.addEventListener('input', () => {
    if (globalSearch) globalSearch.value = queryInput.value;
    window.clearTimeout(debounce);
    debounce = window.setTimeout(() => { syncUrl(); if (catalogReady) void load(true); else filterDemo(); }, 250);
  });
  globalSearch?.addEventListener('input', () => {
    queryInput.value = globalSearch.value;
    window.clearTimeout(debounce);
    debounce = window.setTimeout(() => { syncUrl(); if (catalogReady) void load(true); else filterDemo(); }, 250);
  });
  globalSearch?.form?.addEventListener('submit', (event) => { event.preventDefault(); queryInput.value = globalSearch.value; syncUrl(); void load(true); });
  form.addEventListener('change', () => { syncUrl(); if (catalogReady) void load(true); else filterDemo(); });
  form.addEventListener('submit', (event) => { event.preventDefault(); syncUrl(); if (catalogReady) void load(true); else filterDemo(); });
  loadMore.addEventListener('click', () => {
    autoLoadEnabled = true;
    loadMore.textContent = 'Carregar mais ofertas';
    void load(false);
  });
  if ('IntersectionObserver' in window) new IntersectionObserver((entries) => {
    if (autoLoadEnabled && entries.some((entry) => entry.isIntersecting) && !loadMore.hidden) void load(false);
  }, { rootMargin: '600px' }).observe(sentinel);
</script>

<style>
  .home-intro { background: #fff; border-bottom: 1px solid #e5e5e5; padding: 38px 0 34px; }
  .intro-inner { max-width: 1240px; }
  .eyebrow { color: #555; font-size: .78rem; font-weight: 700; letter-spacing: .09em; margin-bottom: 8px; }
  .intro-inner h1 { color: #222; font-size: clamp(1.8rem, 4vw, 2.65rem); letter-spacing: -.03em; }
  .intro-inner > p:not(.eyebrow) { color: #555; margin-top: 10px; max-width: 700px; }
  .intro-points { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0 0; padding: 0; list-style: none; }
  .intro-points li { display: inline-flex; min-height: 38px; align-items: center; gap: 9px; padding: 6px 12px 6px 7px; border: 1px solid #e2dfd8; border-radius: 6px; background: #fbfaf7; color: #48463f; font-size: .82rem; font-weight: 550; }
  .intro-points li span { display: grid; width: 24px; height: 24px; flex: 0 0 24px; place-items: center; border-radius: 4px; background: #f0ece4; color: #765b37; font-size: .66rem; font-weight: 750; font-variant-numeric: tabular-nums; }
  .demo-notice { background: #fff8e5; border-left: 3px solid #d69e00; padding: 9px 12px; margin-top: 16px !important; font-size: .88rem; }
  .catalog-section { padding-top: 32px; padding-bottom: 56px; }
  .catalog-section > h2, .results-heading h2 { color: #222; font-size: 1.2rem; }
  .catalog-filters { display: grid; grid-template-columns: minmax(200px, 2fr) repeat(4, minmax(120px, 1fr)) auto; gap: 12px; padding: 18px; margin: 14px 0 30px; background: #fff; border: 1px solid #dedede; border-radius: 8px; }
  .catalog-filters label { display: grid; gap: 6px; color: #444; font-size: .8rem; font-weight: 600; }
  .catalog-filters input, .catalog-filters select { min-width: 0; width: 100%; min-height: 42px; border: 1px solid #c8c8c8; border-radius: 5px; padding: 8px 10px; color: #222; background: #fff; font: inherit; }
  .catalog-filters .btn-primary { align-self: end; }
  .results-heading { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; }
  .results-heading span { color: #666; font-size: .84rem; }
  .catalog-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .catalog-card { min-width: 0; overflow: hidden; display: flex; flex-direction: column; background: white; border: 1px solid #e0e0e0; border-radius: 9px; transition: box-shadow .18s ease, transform .18s ease, border-color .18s ease; }
