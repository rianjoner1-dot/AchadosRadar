---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Minha lista | Achados Radar" description="Produtos salvos para consultar e comprar individualmente na loja parceira.">
  <div class="container cart-page">
    <header class="cart-heading"><p class="cart-eyebrow">ACHADOS RADAR</p><h1>Minha lista</h1><p>Guarde produtos para consultar depois. Cada compra é concluída separadamente no marketplace.</p></header>
    <aside class="cart-notice"><strong>Como funciona:</strong> sua lista não reserva estoque e não cobra pagamentos. Preços e disponibilidade podem mudar na loja.</aside>
    <section id="cartEmpty" class="cart-empty" hidden><h2>Sua lista está vazia</h2><p>Explore as ofertas e salve os produtos que interessam.</p><a href="/" class="btn-primary">Ver ofertas</a></section>
    <section id="cartContent" hidden><div class="cart-topline"><span id="cartCount" aria-live="polite"></span><button type="button" id="clearCart" class="text-button">Limpar lista</button></div><div id="cartItems" class="cart-items"></div></section>
    <p id="cartStatus" role="status" aria-live="polite"></p>
  </div>
</Layout>
<script>
  import { escapeHtml } from '../modules/catalog/client';
  import { readLocalCart, removeCartItem, clearLocalCart, updateCartBadge } from '../modules/cart/store';
  import type { CartItem } from '../modules/catalog/types';

  const empty = document.querySelector<HTMLElement>('#cartEmpty')!;
  const content = document.querySelector<HTMLElement>('#cartContent')!;
  const list = document.querySelector<HTMLElement>('#cartItems')!;
  const status = document.querySelector<HTMLElement>('#cartStatus')!;
  const validUuid = (id: string) => /^[0-9a-f]{8}-[0-9a-f-]{27,}$/i.test(id);
  const storeName = (platform: string) => platform === 'magalu' ? 'Magalu' : 'Mercado Livre';
  let renderVersion = 0;

  function renderLocalCart(): CartItem[] {
    const items = readLocalCart();
    updateCartBadge();
    empty.hidden = items.length > 0;
    content.hidden = items.length === 0;
    if (!items.length) { list.replaceChildren(); return items; }
    document.querySelector('#cartCount')!.textContent = `${items.length} produto${items.length === 1 ? '' : 's'} salvo${items.length === 1 ? '' : 's'}`;
    list.innerHTML = items.map((item: CartItem) => `<article class="saved-item" data-id="${escapeHtml(item.id)}">
      <a class="saved-image" href="/produto?id=${encodeURIComponent(item.id)}">${item.image ? `<img src="${escapeHtml(item.image)}" alt="" width="120" height="120" loading="lazy">` : '<span>Imagem indisponível</span>'}</a>
      <div class="saved-info"><span class="saved-store">${escapeHtml(item.platform === 'magalu' ? 'Magalu' : 'Mercado Livre')}</span><h2><a href="/produto?id=${encodeURIComponent(item.id)}">${escapeHtml(item.title)}</a></h2><p class="saved-seller">${item.sellerName ? `Vendido por ${escapeHtml(item.sellerName)}` : ''}</p><p class="saved-price">${escapeHtml(item.priceFormatted || 'Preço atual indisponível')}</p><p class="saved-state" data-state>Verificando preço, estoque e link atuais...</p></div>
      <div class="saved-actions"><a class="btn-primary saved-buy" data-buy aria-disabled="true">Verificando link</a><a class="btn-secondary saved-details" href="/produto?id=${encodeURIComponent(item.id)}">Detalhes</a><button type="button" class="remove-saved" data-remove="${escapeHtml(item.id)}">Remover</button></div>
    </article>`).join('');

    list.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((button) => button.addEventListener('click', async () => {
      const id = button.dataset.remove!;
      button.disabled = true;
      try {
        const auth = await import('../modules/auth/client').catch(() => null);
        if (auth) await auth.removeRemoteCartItem(id);
        removeCartItem(id);
      }
      catch { status.textContent = 'Não foi possível sincronizar a remoção. Tente novamente; o produto continua salvo.'; button.disabled = false; }
    }));
    return items;
  }

  async function updateOfferStates(items: CartItem[], version: number): Promise<void> {
    let catalog: typeof import('../modules/catalog/client');
    let outbound: typeof import('../modules/outbound/readiness.mjs');
    try {
      [catalog, outbound] = await Promise.all([
        import('../modules/catalog/client'),
        import('../modules/outbound/readiness.mjs')
      ]);
    } catch {
      for (const item of items) {
        const row = [...list.querySelectorAll<HTMLElement>('.saved-item')].find((element) => element.dataset.id === item.id);
        const state = row?.querySelector<HTMLElement>('[data-state]');
        if (state) state.textContent = 'Não foi possível atualizar a oferta agora. Seu item continua salvo.';
      }
      return;
    }
    const { catalogReady, getCatalogProduct } = catalog;
    const { evaluateOfferReadiness } = outbound;
    for (const item of items) {
      const row = [...list.querySelectorAll<HTMLElement>('.saved-item')].find((element) => element.dataset.id === item.id);
      if (!row || version !== renderVersion) return;
      const state = row.querySelector<HTMLElement>('[data-state]')!;
      const buy = row.querySelector<HTMLAnchorElement>('[data-buy]')!;
      if (!catalogReady || !validUuid(item.id)) { state.textContent = 'Exemplo local: esta amostra não tem link de compra ativo.'; continue; }
      try {
        const latest = await getCatalogProduct(item.id);
        if (!latest) { state.textContent = 'Produto não está publicado no catálogo; ele continua salvo nesta lista.'; continue; }
        const offer = latest.offer;
        const link = latest.affiliate_link;
        const readiness = evaluateOfferReadiness({ link, offer });
        state.textContent = readiness.ready ? readiness.reason : readiness.reason + ' O item continua salvo.';
        if (readiness.ready) { buy.href = `/api/out/${encodeURIComponent(item.id)}`; buy.target = '_blank'; buy.rel = 'noopener noreferrer'; buy.textContent = `Continuar na ${storeName(latest.platform)}`; buy.removeAttribute('aria-disabled'); }
        else { buy.textContent = 'Link em verificação'; buy.setAttribute('aria-disabled', 'true'); }
      } catch { state.textContent = 'Não foi possível atualizar a oferta agora. Seu item continua salvo.'; }
    }
  }

  async function render() {
    const version = ++renderVersion;
    let items = renderLocalCart();
    let auth: typeof import('../modules/auth/client');
    try { auth = await import('../modules/auth/client'); } catch { return; }
    let user = null;
    try { user = await auth.currentUser(); } catch { /* local list remains usable if session lookup is unavailable */ }
    if (version !== renderVersion) return;
    if (user) {
      try {
        await auth.syncCartForUser(user.id);
        if (version !== renderVersion) return;
        items = renderLocalCart();
      } catch { status.textContent = 'A sincronização não está disponível agora. Os itens salvos neste navegador continuam visíveis.'; }
    }
    if (version === renderVersion) await updateOfferStates(items, version);
  }

  document.querySelector<HTMLButtonElement>('#clearCart')!.addEventListener('click', async () => {
    if (confirm('Remover todos os itens salvos desta conta/dispositivo?')) {
      const button = document.querySelector<HTMLButtonElement>('#clearCart')!;
      button.disabled = true;
      try {
        const auth = await import('../modules/auth/client').catch(() => null);
        if (auth) await auth.clearRemoteCart();
        clearLocalCart();
      }
      catch { status.textContent = 'Não foi possível sincronizar a limpeza. Os itens continuam salvos.'; }
      finally { button.disabled = false; }
    }
  });
  document.addEventListener('cart:changed', () => void render());
  void render();
</script>
<style>
  .cart-page { max-width:1040px; padding-top:38px; padding-bottom:60px; }
  .cart-heading h1 { color:#222; font-size:2rem; }
  .cart-heading p { color:#666; margin-top:6px; }
  .cart-eyebrow { color:#555 !important; font-size:.75rem; letter-spacing:.08em; font-weight:700; }
  .cart-notice { background:#f5f5f5; border:1px solid #ddd; border-radius:6px; padding:14px 16px; margin:22px 0; color:#444; font-size:.88rem; }
  .cart-empty { text-align:center; padding:46px 16px; border:1px dashed #ccc; border-radius:8px; }
  .cart-empty h2 { color:#222; }
  .cart-empty p { margin:8px 0 16px; color:#666; }
  .cart-topline { display:flex; justify-content:space-between; align-items:center; margin:24px 0 12px; color:#555; font-size:.88rem; }
  .text-button, .remove-saved { color:#555; text-decoration:underline; padding:8px; }
  .cart-items { display:grid; gap:12px; }
  .saved-item { display:grid; grid-template-columns:120px minmax(0,1fr) auto; gap:18px; align-items:center; padding:14px; border:1px solid #ddd; border-radius:7px; background:#fff; }
  .saved-image { width:120px; height:120px; display:grid; place-items:center; }
  .saved-image img { width:100%; height:100%; object-fit:contain; }
  .saved-store { color:#666; font-size:.7rem; text-transform:uppercase; font-weight:700; }
  .saved-info h2 { color:#222; font:500 .98rem/1.4 var(--font-body); margin:5px 0; }
  .saved-seller, .saved-state { color:#666; font-size:.78rem; margin-top:4px; }
  .saved-price { color:#222; font-weight:700; margin-top:7px; }
  .saved-actions { display:flex; flex-direction:column; align-items:stretch; gap:7px; min-width:150px; }
  .saved-actions .btn-primary, .saved-actions .btn-secondary { min-height:38px; font-size:.82rem; padding:7px 10px; }
  .saved-buy[aria-disabled="true"] { opacity:.55; pointer-events:none; }
  #cartStatus { color:#555; margin-top:10px; }
  @media(max-width:700px) { .saved-item { grid-template-columns:82px minmax(0,1fr); gap:12px; } .saved-image { width:82px;height:82px; } .saved-actions { grid-column:1/-1; display:grid; grid-template-columns:1fr 1fr; } .saved-actions .remove-saved { grid-column:1/-1; } }
</style>
