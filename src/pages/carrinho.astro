---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Minha lista | Achados Radar" description="Produtos salvos para consultar e comprar individualmente na loja parceira.">
  <div class="container cart-page">
    <header class="cart-heading"><p class="cart-eyebrow">ACHADOS RADAR</p><h1>Minha lista</h1><p>Guarde produtos para consultar depois. Cada compra é concluída separadamente no marketplace.</p></header>
    <aside class="cart-notice"><strong>Como funciona:</strong> sua lista não reserva estoque e não cobra pagamentos. Preços e disponibilidade podem mudar na loja.</aside>
    <section id="cartEmpty" class="cart-empty" hidden><h2>Sua lista está vazia</h2><p>Explore as ofertas e salve os produtos que interessam.</p><a href="/" class="btn-primary">Ver ofertas</a></section>
    <section id="cartContent" hidden><div class="cart-topline"><span id="cartCount" aria-live="polite"></span><button type="button" id="clearCart" class="text-button">Limpar lista</button></div><div id="cartItems" class="cart-items"></div></section>
    <span id="cartLoader" class="orb-loader" aria-hidden="true" hidden><i></i><i></i><i></i></span>
    <p id="cartStatus" role="status" aria-live="polite"></p>
  </div>
</Layout>
<script>
  import { escapeHtml } from '../modules/catalog/client';
  import { readLocalCart, removeCartItemSnapshot, removeCartItems, updateCartBadge } from '../modules/cart/store';
  import { formatLinkTiming, hasElapsedLinkDeadline } from '../modules/outbound/readiness.mjs';
  import type { CartItem } from '../modules/catalog/types';

  const empty = document.querySelector<HTMLElement>('#cartEmpty')!;
  const content = document.querySelector<HTMLElement>('#cartContent')!;
  const list = document.querySelector<HTMLElement>('#cartItems')!;
  const status = document.querySelector<HTMLElement>('#cartStatus')!;
  const cartLoader = document.querySelector<HTMLElement>('#cartLoader')!;
  const setStatus = (message: string, loading = false) => { status.textContent = message; cartLoader.hidden = !loading; };
  const validUuid = (id: string) => /^[0-9a-f]{8}-[0-9a-f-]{27,}$/i.test(id);
  const storeName = (platform: string) => ({ mercadolivre: 'Mercado Livre', magalu: 'Magalu', amazon: 'Amazon', shopee: 'Shopee', kabum: 'KaBuM!' } as Record<string, string>)[platform] ?? 'Loja parceira';
  let renderVersion = 0;
  let authSubscriptionReady = false;

  function renderLocalCart(ownerId?: string | null): CartItem[] {
    const items = readLocalCart(ownerId);
    updateCartBadge(ownerId);
    empty.hidden = items.length > 0;
    content.hidden = items.length === 0;
    if (!items.length) { list.replaceChildren(); return items; }
    document.querySelector('#cartCount')!.textContent = `${items.length} produto${items.length === 1 ? '' : 's'} salvo${items.length === 1 ? '' : 's'}`;
    list.dataset.cartOwner = ownerId ?? '';
    list.innerHTML = items.map((item: CartItem) => `<article class="saved-item" data-id="${escapeHtml(item.id)}">
      <a class="saved-image" href="/produto?id=${encodeURIComponent(item.id)}">${item.image ? `<img src="${escapeHtml(item.image)}" alt="" width="120" height="120" loading="lazy">` : '<span>Imagem indisponível</span>'}</a>
      <div class="saved-info"><div class="saved-labels"><span class="saved-store">${escapeHtml(item.platform === 'magalu' ? 'Magalu' : 'Mercado Livre')}</span><span class="saved-state" data-state data-tone="checking" role="status">Verificando oferta</span></div><h2><a href="/produto?id=${encodeURIComponent(item.id)}">${escapeHtml(item.title)}</a></h2><div class="saved-price-panel"><span>Preço observado</span><strong data-price>${escapeHtml(item.priceFormatted || 'Consulte a loja')}</strong></div>
        <details class="saved-more"><summary>Detalhes da oferta</summary><div class="saved-more-content"><p class="saved-offer-facts" data-offer-facts hidden></p><p class="saved-expiry" data-expiry hidden></p><p class="saved-explanation" data-explanation>Atualizando as informações da oferta...</p></div></details>
      </div>
      <div class="saved-actions"><a class="btn-primary saved-buy" data-buy aria-disabled="true">Verificando oferta</a><a class="btn-secondary saved-details" href="/produto?id=${encodeURIComponent(item.id)}">Ver produto</a><button type="button" class="remove-saved" data-remove="${escapeHtml(item.id)}">Remover da lista</button></div>
    </article>`).join('');

    list.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((button) => button.addEventListener('click', async () => {
      const id = button.dataset.remove!;
      const ownerId = list.dataset.cartOwner || null;
      const itemSnapshot = readLocalCart(ownerId).find((saved) => saved.id === id);
      if (!itemSnapshot) { void render(); return; }
      const removalSnapshot = { id: itemSnapshot.id, savedAt: itemSnapshot.savedAt };
      button.disabled = true;
      try {
        const auth = await import('../modules/auth/client').catch(() => null);
        if (ownerId && !auth) throw new Error('A sessão da conta não pôde ser confirmada.');
        if (auth) await auth.removeRemoteCartItem(id, ownerId);
        removeCartItemSnapshot(removalSnapshot, ownerId);
      }
      catch { setStatus('Não foi possível sincronizar a remoção. Tente novamente; o produto continua salvo.'); button.disabled = false; }
    }));
    return items;
  }

  async function updateOfferStates(items: CartItem[], version: number): Promise<void> {
    let catalog: typeof import('../modules/catalog/client');
    let outbound: typeof import('../modules/outbound/readiness.mjs');
    try {
      [catalog, outbound] = await Promise.all([
        import('../modules/catalog/client'),
        import('../modules/outbound/readiness.mjs')
      ]);
    } catch {
      for (const item of items) {
        const row = [...list.querySelectorAll<HTMLElement>('.saved-item')].find((element) => element.dataset.id === item.id);
        const state = row?.querySelector<HTMLElement>('[data-state]');
        if (state) { state.textContent = 'Oferta indisponível'; state.dataset.tone = 'unavailable'; }
        const explanation = row?.querySelector<HTMLElement>('[data-explanation]');
        if (explanation) explanation.textContent = 'Não foi possível atualizar a oferta agora. O produto continua salvo na sua lista.';
      }
      return;
    }
    const { catalogReady, getCatalogProduct, formatPrice } = catalog;
    const { evaluateOfferReadiness } = outbound;
    const updateItem = async (item: CartItem) => {
      const row = [...list.querySelectorAll<HTMLElement>('.saved-item')].find((element) => element.dataset.id === item.id);
      if (!row || version !== renderVersion) return;
      const state = row.querySelector<HTMLElement>('[data-state]')!;
      const explanation = row.querySelector<HTMLElement>('[data-explanation]')!;
      const buy = row.querySelector<HTMLAnchorElement>('[data-buy]')!;
      const disableBuy = (label = 'Oferta indisponível') => {
        buy.removeAttribute('href');
        buy.removeAttribute('target');
        buy.removeAttribute('rel');
        buy.setAttribute('aria-disabled', 'true');
        buy.textContent = label;
      };
      const setStatus = (label: string, tone: string, detail: string) => { state.textContent = label; state.dataset.tone = tone; explanation.textContent = detail; };
      if (!catalogReady || !validUuid(item.id)) { setStatus('Amostra', 'checking', 'Este produto de demonstração não tem um link de compra ativo.'); return; }
      try {
        const latest = await getCatalogProduct(item.id);
        if (version !== renderVersion) return;
        if (!latest) {
          row.querySelector<HTMLElement>('[data-price]')!.textContent = item.priceFormatted || 'Consulte a loja';
          setStatus('Oferta indisponível', 'unavailable', 'Este produto não está mais no catálogo. Ele continua salvo na sua lista, mas não pode ser comprado por este link.');
          buy.textContent = 'Produto indisponível';
          buy.removeAttribute('href');
          buy.setAttribute('aria-disabled', 'true');
          const details = row.querySelector<HTMLAnchorElement>('.saved-details');
          if (details) details.hidden = true;
          row.querySelectorAll<HTMLAnchorElement>('a[href*="/produto?id="]').forEach((link) => {
            link.removeAttribute('href');
            link.setAttribute('aria-disabled', 'true');
          });
          return;
        }
        const offer = latest.offer;
        const link = latest.affiliate_link;
        row.dataset.linkExpiresAt = link?.expires_at ?? '';
        row.dataset.linkRefreshDueAt = link?.refresh_due_at ?? '';
        row.dataset.linkStatus = link?.status ?? '';
        row.dataset.linkVerifiedAt = link?.verified_at ?? '';
        const expiry = row.querySelector<HTMLElement>('[data-expiry]')!;
        expiry.hidden = !link?.expires_at && !link?.refresh_due_at;
        if (!expiry.hidden) expiry.textContent = formatLinkTiming(link);
        const price = row.querySelector<HTMLElement>('[data-price]')!;
        const facts = row.querySelector<HTMLElement>('[data-offer-facts]')!;
        if (offer?.observed_at) {
          price.textContent = formatPrice(offer.price);
          const factList = [
            offer.installments_text,
            offer.shipping_text,
            offer.coupon_code ? `Cupom ${offer.coupon_code}` : ''
          ].filter(Boolean);
          facts.textContent = factList.join(' · ');
          facts.hidden = factList.length === 0;
        } else {
          price.textContent = item.priceFormatted || 'Consulte a loja';
          facts.hidden = true;
          facts.textContent = '';
        }
        const readiness = evaluateOfferReadiness({ link, offer });
        row.dataset.offerReady = String(readiness.ready);
        const reason = readiness.reason || '';
        const normalizedReason = reason.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
        const label = readiness.ready ? 'Disponível para compra'
          : /expir|prazo/.test(normalizedReason) ? 'Link expirado'
          : /revis|verific|desatualiz/.test(normalizedReason) ? 'Link em verificação'
          : /sem estoque/.test(normalizedReason) ? 'Sem estoque'
          : /estoque|disponibilidade/.test(normalizedReason) ? 'Estoque a confirmar'
          : 'Oferta indisponível';
        const safeLink = link as unknown as Record<string, string> | null;
        const targetUrl = safeLink?.affiliate_url || safeLink?.original_url || `/api/out/${encodeURIComponent(item.id)}`;
        if (readiness.ready) { buy.href = `/api/out/${encodeURIComponent(item.id)}`; buy.target = '_blank'; buy.rel = 'noopener noreferrer'; buy.textContent = `Continuar na ${storeName(latest.platform)}`; buy.removeAttribute('aria-disabled'); }
        else if (targetUrl) { buy.href = targetUrl; buy.target = '_blank'; buy.rel = 'noopener noreferrer'; buy.textContent = `Continuar na ${storeName(latest.platform)}`; buy.removeAttribute('aria-disabled'); }
        else { disableBuy(label); }
      } catch {
        if (version === renderVersion) {
          disableBuy();
          setStatus('Oferta indisponível', 'checking', 'Não foi possível atualizar a oferta agora. O produto continua salvo na sua lista.');
        }
      }
    };
    const pending = [...items];
    const workerCount = Math.min(3, pending.length);
    await Promise.all(Array.from({ length: workerCount }, async () => {
      while (version === renderVersion) {
        const item = pending.shift();
        if (!item) return;
        await updateItem(item);
      }
    }));
  }

  function updateCartLinkTimes() {
    for (const row of list.querySelectorAll<HTMLElement>('.saved-item')) {
      const timing = row.querySelector<HTMLElement>('[data-expiry]');
      if (!timing || timing.hidden) continue;
      timing.textContent = formatLinkTiming({
        expires_at: row.dataset.linkExpiresAt,
        refresh_due_at: row.dataset.linkRefreshDueAt,
        status: row.dataset.linkStatus,
        verified_at: row.dataset.linkVerifiedAt
      });
      const link = { expires_at: row.dataset.linkExpiresAt, refresh_due_at: row.dataset.linkRefreshDueAt };
      if (hasElapsedLinkDeadline(link) && row.dataset.offerReady === 'true') {
        const buy = row.querySelector<HTMLAnchorElement>('[data-buy]');
        buy?.removeAttribute('href');
        buy?.removeAttribute('target');
        buy?.removeAttribute('rel');
        buy?.setAttribute('aria-disabled', 'true');
        if (buy) buy.textContent = 'Link em verificação';
        const state = row.querySelector<HTMLElement>('[data-state]');
        if (state) { state.textContent = link.expires_at && Date.parse(link.expires_at) <= Date.now() ? 'Link expirado' : 'Link em verificação'; state.dataset.tone = 'checking'; }
        const explanation = row.querySelector<HTMLElement>('[data-explanation]');
        if (explanation) explanation.textContent = link.expires_at && Date.parse(link.expires_at) <= Date.now()
          ? 'O prazo oficial do link terminou. O produto continua salvo; a compra fica indisponível até a oferta ser atualizada.'
          : 'A revisão interna do link venceu. O produto continua salvo; a compra fica temporariamente indisponível.';
      }
    }
  }

  async function render() {
    const version = ++renderVersion;
    let auth: typeof import('../modules/auth/client');
    setStatus('Carregando sua lista...', true);
    try { auth = await import('../modules/auth/client'); }
    catch {
      const localItems = renderLocalCart(null);
      setStatus(localItems.length
        ? 'Os itens continuam salvos neste navegador. A sincronização da conta não está disponível agora.'
        : 'A conta não pôde ser carregada. Você ainda pode salvar produtos neste navegador.');
      return;
    }
    if (auth.supabase && !authSubscriptionReady) {
      auth.supabase.auth.onAuthStateChange(() => { void render(); });
      authSubscriptionReady = true;
    }
    let user = null;
    let sessionLookupFailed = false;
    try { user = await auth.currentUser(); }
    catch { sessionLookupFailed = true; setStatus('Não foi possível confirmar a sessão; exibindo apenas a lista anônima.', true); }
    if (version !== renderVersion) return;
    if (user) {
      try {
        await auth.syncCartForUser(user.id);
      } catch { setStatus('A sincronização não está disponível agora. Os itens salvos neste navegador continuam visíveis.', true); }
      let confirmedUser = null;
      try { confirmedUser = await auth.currentUser(); }
      catch {
        if (version !== renderVersion) return;
        const guestItems = renderLocalCart(null);
        status.textContent = 'Não foi possível confirmar sua sessão. Sua lista da conta permanece salva e oculta até a conexão voltar.';
        cartLoader.hidden = false;
        await updateOfferStates(guestItems, version);
        cartLoader.hidden = true;
        return;
      }
      if (version !== renderVersion) return;
      if (confirmedUser?.id !== user.id) { void render(); return; }
    }
    if (version !== renderVersion) return;
    const items = renderLocalCart(user?.id ?? null);
    if (!sessionLookupFailed && !status.textContent.startsWith('A sincronização')) setStatus('');
    if (version === renderVersion) await updateOfferStates(items, version);
    cartLoader.hidden = true;
  }

  document.querySelector<HTMLButtonElement>('#clearCart')!.addEventListener('click', async () => {
    if (confirm('Remover todos os itens salvos desta conta/dispositivo?')) {
      const button = document.querySelector<HTMLButtonElement>('#clearCart')!;
      button.disabled = true;
      const ownerId = list.dataset.cartOwner || null;
      const clearSnapshot = readLocalCart(ownerId).map(({ id, savedAt }) => ({ id, savedAt }));
      try {
        const auth = await import('../modules/auth/client').catch(() => null);
        if (ownerId && !auth) throw new Error('A sessão da conta não pôde ser confirmada.');
        if (auth) await auth.clearRemoteCart(ownerId);
        removeCartItems(clearSnapshot, ownerId);
      }
      catch { setStatus('Não foi possível sincronizar a limpeza. Os itens continuam salvos.'); }
      finally { button.disabled = false; }
    }
  });
  document.addEventListener('cart:changed', () => void render());
  window.setInterval(updateCartLinkTimes, 60_000);
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) void render();
  });
  window.addEventListener('storage', (event) => {
    if (event.key === 'achados_radar_cart_owner' || event.key === 'achados_radar_cart' || event.key?.startsWith('achados_radar_cart:')) void render();
  });
  void render();
</script>
<style is:global>
  .cart-page { max-width:1040px; padding-top:38px; padding-bottom:60px; }
  .cart-heading h1 { color:#262820; font-size:2rem; letter-spacing:-.025em; }
  .cart-heading p { color:#625f58; margin-top:6px; }
  .cart-eyebrow { color:#657b62 !important; font-size:.75rem; letter-spacing:.1em; font-weight:750; }
  .cart-notice { background:#f1f5ef; border:1px solid #dfe8dc; border-left:4px solid #78917a; border-radius:8px; padding:14px 16px; margin:22px 0; color:#454c43; font-size:.88rem; }
  .cart-empty { text-align:center; padding:46px 16px; border:1px dashed #c9cec4; border-radius:10px; background:#fafbf8; }
  .cart-empty h2 { color:#222; }
  .cart-empty p { margin:8px 0 16px; color:#666; }
  .cart-topline { display:flex; justify-content:space-between; align-items:center; margin:24px 0 12px; color:#555; font-size:.88rem; }
  .text-button, .remove-saved { color:#555; text-decoration:underline; padding:8px; }
  .cart-items { display:grid; gap:14px; }
  .saved-item { display:grid; grid-template-columns:142px minmax(0,1fr) 164px; gap:20px; align-items:center; padding:16px; border:1px solid #e1e1da; border-radius:12px; background:linear-gradient(120deg,#fff 0%,#fff 70%,#fbfaf6 100%); box-shadow:0 2px 8px rgba(39,42,34,.035); }
  .saved-image { width:142px; height:142px; display:grid; place-items:center; overflow:hidden; border:1px solid #efede7; border-radius:9px; background:#f7f6f1; }
  .saved-image img { width:100%; height:100%; padding:9px; object-fit:contain; }
  .saved-image span { padding:10px; color:#777; font-size:.75rem; text-align:center; }
  .saved-labels { display:flex; flex-wrap:wrap; align-items:center; gap:7px; }
  .saved-store, .saved-state { display:inline-flex; align-items:center; min-height:24px; padding:4px 8px; border-radius:5px; font-size:.68rem; line-height:1.2; font-weight:700; }
  .saved-store { background:#f0eee7; color:#625640; letter-spacing:.045em; text-transform:uppercase; }
  .saved-state[data-tone="available"] { background:#edf3ec; color:#346538; }
  .saved-state[data-tone="checking"] { background:#fbf3db; color:#805d16; }
  .saved-state[data-tone="unavailable"] { background:#f8ecea; color:#8d423a; }
  .saved-info h2 { color:#282921; font:650 1rem/1.4 var(--font-body); margin:9px 0 12px; text-wrap:pretty; }
  .saved-info h2 a { color:inherit; text-decoration:none; }
  .saved-info h2 a:hover { text-decoration:underline; text-underline-offset:3px; }
  .saved-price-panel { display:flex; flex-direction:column; gap:1px; width:max-content; min-width:174px; padding:8px 11px; border:1px solid #e1e9df; border-radius:7px; background:#f1f5ef; }
  .saved-price-panel > span { color:#647263; font-size:.67rem; font-weight:600; }
  .saved-price-panel strong { color:#2e5834; font-size:1.2rem; line-height:1.25; font-weight:800; font-variant-numeric:tabular-nums; }
  .saved-more { margin-top:10px; color:#5f6259; font-size:.76rem; }
  .saved-more summary { width:max-content; cursor:pointer; color:#586e5a; font-weight:650; text-underline-offset:3px; }
  .saved-more summary:focus-visible, .saved-item a:focus-visible, .saved-item button:focus-visible { outline:3px solid #78917a; outline-offset:3px; }
  .saved-more-content { padding:8px 10px; margin-top:6px; border-radius:6px; background:#f7f7f3; color:#666; }
  .saved-more-content p { margin:3px 0; }
  .saved-offer-facts, .saved-expiry, .saved-explanation { font-size:.74rem; line-height:1.45; }
  .saved-actions { display:flex; flex-direction:column; align-items:stretch; gap:8px; min-width:0; }
  .saved-actions .btn-primary, .saved-actions .btn-secondary { min-height:40px; font-size:.8rem; padding:8px 10px; text-align:center; }
  .saved-buy[aria-disabled="true"] { opacity:.58; pointer-events:none; }
  .remove-saved { color:#71675f; font-size:.76rem; text-decoration:none; }
  .remove-saved:hover { color:#8d423a; text-decoration:underline; }
  #cartStatus { color:#555; margin-top:10px; }
  @media(max-width:760px) { .saved-item { grid-template-columns:104px minmax(0,1fr); gap:13px; padding:12px; } .saved-image { width:104px;height:104px; } .saved-actions { grid-column:1/-1; display:grid; grid-template-columns:1fr 1fr; } .saved-actions .remove-saved { grid-column:1/-1; justify-self:start; padding:5px 0; } }
  @media(max-width:420px) { .saved-item { grid-template-columns:78px minmax(0,1fr); gap:10px; padding:10px; } .saved-image { width:78px;height:78px; } .saved-info h2 { font-size:.88rem; margin:7px 0 9px; } .saved-price-panel { min-width:0; padding:7px 9px; } .saved-price-panel strong { font-size:1.08rem; } .saved-labels { gap:5px; } .saved-store, .saved-state { font-size:.6rem; padding-inline:6px; } }
</style>
